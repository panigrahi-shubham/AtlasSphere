{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "deployment/vercel.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "api/*.json",
          "dist/*.html",
          "node_modules/.prisma/client/**",
          "node_modules/swagger-ui-dist/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/deployment/vercel.ts" },
    { "src": "/docs(?:/.*)?", "dest": "/deployment/vercel.ts" },
    { "src": "/openapi\\.json", "dest": "/deployment/vercel.ts" },
    { "src": "/journeys/?", "dest": "/journeys.html" },
    { "src": "/geoguess/?", "dest": "/geoguess.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/deployment/vercel.ts" }
  ]
}
