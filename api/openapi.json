  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_INPUT",
                  "NOT_FOUND",
                  "RATE_LIMITED",
                  "UPSTREAM_ERROR",
                  "UPSTREAM_TIMEOUT",
                  "INVALID_NEWS"
                ]
              },
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service",
          "time"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Weather": {
        "type": "object",
        "description": "Raw Open-Meteo forecast response. view=current has current and hourly; view=daily has daily.",
        "properties": {
          "timezone": {
            "type": "string"
          },
          "current": {
            "type": "object"
          },
          "current_units": {
            "type": "object"
          },
          "hourly": {
            "type": "object",
            "properties": {
              "time": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "temperature_2m": {
                "type": "array",
                "items": {
                  "type": "number",
                  "nullable": true
                }
              }
            }
          },
          "daily": {
            "type": "object",
            "properties": {
              "time": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "Geocode": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "latitude",
                "longitude"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "latitude": {
                  "type": "number"
                },
                "longitude": {
                  "type": "number"
                },
                "country": {
                  "type": "string"
                },
                "country_code": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "News": {
        "type": "object",
        "required": [
          "lastUpdated",
          "items"
        ],
        "properties": {
          "lastUpdated": {
            "type": "string",
