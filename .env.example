APP_ENV=development
FIXTURES=0
PORT=3000

DATABASE_URL=postgresql://skyatlas:change-me@127.0.0.1:5432/skyatlas
# Optional direct connection for migrations (use Neon's non-pooled URL).
# npm run prisma:migrate falls back to DATABASE_URL when this is unset.
# DIRECT_DATABASE_URL=postgresql://skyatlas:change-me@127.0.0.1:5432/skyatlas
# CRON_SECRET=replace-with-a-random-server-only-secret
# ALLOWED_ORIGINS=https://your-site.pages.dev
# TRUST_PROXY_HOPS=1
# API_ORIGIN=https://your-render-service.onrender.com
# PROXY_SHARED_SECRET=replace-with-a-random-secret-shared-by-pages-and-render
# VITE_PAGES_FALLBACK=1 # Legacy option; fallback now follows HTTP status only.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# RESET_EMAIL_PROVIDER_URL=https://your-provider.example/send
# RESET_EMAIL_PROVIDER_TOKEN=server-side-token
# Optional customer archive key (Professional or Enterprise); without it the
# free non-commercial Open-Meteo archive is used. Keep the key server-side.
# OPEN_METEO_API_KEY=your-server-side-open-meteo-key

